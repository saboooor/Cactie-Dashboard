{
  "name": "sova-dashboard",
  "version": "9.2.0",
  "description": "Sova dashboard go brr",
  "engines": {
    "node": ">=15.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saboooor/Sova-Dashboard.git"
  },
  "author": "saboooor",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.mts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "wrangler pages publish ./dist --branch preview",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@anuragroy/tailwindcss-animate": "^1.0.6",
    "@builder.io/qwik": "1.20.0",
    "@builder.io/qwik-city": "1.20.0",
    "@emoji-mart/data": "^1.2.1",
    "@luminescent/ui": "^7.0.0",
    "@luminescent/ui-qwik": "^6.8.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/eslint": "9.6.1",
    "@types/node": "25.9.1",
    "@types/uuid": "11.0.0",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "autoprefixer": "10.5.0",
    "discord-api-types": "0.38.48",
    "emoji-mart": "^5.6.0",
    "eslint": "10.4.1",
    "eslint-plugin-qwik": "1.20.0",
    "lucide-icons-qwik": "1.7.0-qwik-v1",
    "prettier": "3.8.3",
    "qwik-ionicons": "1.0.5",
    "simple-icons-qwik": "^16.10.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "undici": "8.3.0",
    "uuid": "14.0.0",
    "vite": "8.0.14",
    "vite-tsconfig-paths": "6.1.1",
    "wrangler": "latest"
  },
  "packageManager": "pnpm@11.5.0"
}
