{
  "name": "sova-dashboard",
  "version": "9.2.0",
  "description": "Sova dashboard go brr",
  "engines": {
    "node": ">=15.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saboooor/Sova-Dashboard.git"
  },
  "author": "saboooor",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "serve": "wrangler dev",
    "start": "vite --open --mode ssr",
    "start.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --forcenode --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@anuragroy/tailwindcss-animate": "^1.0.6",
    "@eslint/js": "^10.0.1",
    "@luminescent/icons-qwik": "0.1.1",
    "@luminescent/ui": "^7.0.0",
    "@luminescent/ui-qwik": "7.0.0-2",
    "@qwik.dev/core": "2.0.0-beta.35",
    "@qwik.dev/router": "2.0.0-beta.35",
    "@tailwindcss/vite": "^4.3.0",
    "@types/eslint": "9.6.1",
    "@types/node": "25.9.1",
    "eslint": "10.4.1",
    "eslint-plugin-qwik": "2.0.0-beta.35",
    "globals": "^17.6.0",
    "lucide-icons-qwik": "1.16.0-qwik-v2",
    "prettier": "3.8.3",
    "simple-icons-qwik": "16.19.0-qwik-v2",
    "tailwindcss": "4.3.0",
    "ts-morph": "^28.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.0",
    "undici": "8.3.0",
    "uuid": "14.0.0",
    "vite": "8.0.14",
    "vite-tsconfig-paths": "6.1.1",
    "wrangler": "^4.95.0"
  },
  "packageManager": "pnpm@11.5.0"
}
